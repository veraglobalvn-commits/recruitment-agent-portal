{
  "name": "T-2A-N8N-002 — Wizard Idle Ping",
  "nodes": [
    {
      "id": "a1b2c3d4-0001-0001-0001-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "* * * * *"
            }
          ]
        }
      }
    },
    {
      "id": "a1b2c3d4-0002-0002-0002-000000000002",
      "name": "Code: Compute Times",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300],
      "parameters": {
        "jsCode": "\nconst now = new Date();\nconst ten_min_ago  = new Date(now.getTime() - 10 * 60 * 1000).toISOString();\nconst thirty_min_ago = new Date(now.getTime() - 30 * 60 * 1000).toISOString();\nreturn [{ json: { ten_min_ago, thirty_min_ago } }];\n"
      }
    },
    {
      "id": "a1b2c3d4-0003-0003-0003-000000000003",
      "name": "Supabase: Get Active Sessions",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [680, 300],
      "parameters": {
        "resource": "row",
        "operation": "getAll",
        "tableId": "bot_sessions",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "current_step",
              "condition": "neq",
              "keyValue": "IDLE"
            },
            {
              "keyName": "last_activity_at",
              "condition": "lt",
              "keyValue": "={{ $('Code: Compute Times').item.json.ten_min_ago }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "8dnBpfQkmISrai1T",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "a1b2c3d4-0004-0004-0004-000000000004",
      "name": "Code: Classify Sessions",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "jsCode": "\n// Native Supabase getAll returns 1 item per row — no array loop needed\nconst s = $input.item.json;\nif (!s.chat_id || !s.last_activity_at) return [];\nconst thirty_min_ago = $('Code: Compute Times').item.json.thirty_min_ago;\nconst thirtyMs = new Date(thirty_min_ago).getTime();\nconst actMs  = new Date(s.last_activity_at).getTime();\nconst type   = actMs < thirtyMs ? 'expired' : 'idle';\nreturn [{ json: { chat_id: s.chat_id, telegram_user_id: s.telegram_user_id, type } }];\n"
      }
    },
    {
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "IF: Is Expired",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-0001",
              "leftValue": "={{ $json.type }}",
              "rightValue": "expired",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Telegram: Send Expired",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 180],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "Session expired due to inactivity. Type /add to start again.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Supabase: Delete Session",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1560, 180],
      "parameters": {
        "resource": "row",
        "operation": "delete",
        "tableId": "bot_sessions",
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "chat_id",
              "condition": "eq",
              "keyValue": "={{ $('IF: Is Expired').item.json.chat_id }}"
            }
          ]
        }
      },
      "credentials": {
        "supabaseApi": {
          "id": "8dnBpfQkmISrai1T",
          "name": "Supabase account"
        }
      }
    },
    {
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Telegram: Send Idle Ping",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1340, 420],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "Still there? Type /cancel to exit or continue where you left off.",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "1",
          "name": "Telegram Bot"
        }
      }
    }
  ],
